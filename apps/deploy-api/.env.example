# SSE Market OAuth（见 deploy/oauth/README.md）
OAUTH_BASE_URL=https://ssemarket.cn/new
OAUTH_API_BASE_URL=https://ssemarket.cn
# 生产: ssemarket-sdpy / 本地: ssemarket-sdpy_local
OAUTH_APP_ID=
OAUTH_APP_SECRET=
# 生产: https://ssemarket.cn/sdpy/oauth/callback
# 本地: http://localhost:5174/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:5174/oauth/callback
# deploy.ssemarket.cn 子域入口（同 app_id，独立回调与密钥，见 register-oauth-apps.sql alt_*）
OAUTH_DEPLOY_HOST=deploy.ssemarket.cn
OAUTH_REDIRECT_URI_DEPLOY=https://deploy.ssemarket.cn/oauth/callback
OAUTH_APP_SECRET_DEPLOY=
OAUTH_AUTHORIZE_PATH=/connect
# 平台管理员（OAuth 用户 ID，多个用逗号分隔）；留空默认 561
PLATFORM_ADMIN_OAUTH_IDS=561

PORT=3002
NODE_ENV=development
BASE_DOMAIN=ssemarket.cn
# 模块公网前缀：默认根路径模式 → /test/{m}、/{m}
# 设为 /sdpy 则为前缀模式 → /sdpy/test/{m}、/sdpy/{m}（管理站仍建议挂 /sdpy/）
PUBLIC_BASE_PATH=/
DEPLOY_PORT_START=8100
UPLOAD_MAX_MB=200
# 同时执行的部署任务上限（构建较重，建议 2，避免压垮宿主机）
MAX_CONCURRENT_DEPLOYS=2

# —— Agent LLM（优先管理台「AI 端点」；以下为 env 回退）——
# DeepSeek OpenAI 兼容：https://api-docs.deepseek.com/zh-cn/
# DEEPSEEK_API_KEY=sk-...
# AGENT_FIXER_BASE_URL=https://api.deepseek.com/chat/completions
# AGENT_FIXER_API_KEY=   # 可与 DEEPSEEK_API_KEY 二选一
# AGENT_FIXER_MODEL=deepseek-v4-flash   # 或 deepseek-v4-pro
AGENT_FIXER_ENABLED=
AGENT_FIXER_BASE_URL=https://api.deepseek.com/chat/completions
AGENT_FIXER_API_KEY=
AGENT_FIXER_MODEL=deepseek-v4-flash
AGENT_MAX_ATTEMPTS=1

# 本地裸跑可用相对路径；Docker 生产由 compose 覆盖为 ${SDPY_HOST_DATA}/data
DEPLOY_DATA_DIR=./data
WORK_DIR=./data/work

# —— Docker 生产必填 ——
# 本 api 目录在宿主机上的绝对路径，例如：
#   SDPY_HOST_DATA=/opt/release-sdpy/api
#   SDPY_HOST_DATA=/root/SSE_Market/sse-sdpy/api
# 持久化统一在 ${SDPY_HOST_DATA}/data/（库、uploads、work、nginx），rebuild 不丢
SDPY_HOST_DATA=

# 用户模块数据根目录（按模块名分子目录，不存在会自动创建）
# 实际路径：{MODULE_DATA_ROOT}/{模块名}/{test|prod}  →  挂进该模块 api 容器的 /data
MODULE_DATA_ROOT=/root/SSE_Market/sse-sdpy/data

# GATEWAY_RELOAD_CMD=docker exec sse_market_server-nginx_proxy-1 nginx -s reload
# GATEWAY_UPSTREAM_HOST=host.docker.internal

# —— 部署运行时（默认 sseinfra）——
# compose = 本机 docker compose（旧路径）
# sseinfra = 调 http://ssemarket.cn:24000 建组 + 仓库 deploy.sh
DEPLOY_RUNTIME=sseinfra
SSEINFRA_BASE_URL=http://ssemarket.cn:24000
# 面板登录（student-platform :24000）；须 admin + SSE_Market 才有建组/看组权限
SSEINFRA_USERNAME=admin
SSEINFRA_PASSWORD=
# 兼容根目录 .env：k8s_username / k8s_password
# 组名前缀 → 实际组名 {prefix}-{module}-t|p
SSEINFRA_GROUP_PREFIX=sdpy
SSEINFRA_DEFAULT_CPU=2
SSEINFRA_DEFAULT_MEM=4Gi
SSEINFRA_DEFAULT_STORAGE=10
# 私有仓时注入表单 token（用户可不贴个人 key）；模块级 git_token 优先
SSEINFRA_GITEE_TOKEN=

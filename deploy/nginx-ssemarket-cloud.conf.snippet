# 集市云 / sseinfra 面板 — 子域名 cloud.ssemarket.cn → 宿主机 :24000（frps）
# 放入 nginx_proxy 的 http {} 内（与主站 443 server 并列），勿塞进主站 location。
#
# 前置：
# 1. DNS：cloud.ssemarket.cn A → 与 ssemarket.cn 相同 IP
# 2. 证书 SAN 含 cloud.ssemarket.cn（certbot --expand）

  server {
    listen 80;
    server_name cloud.ssemarket.cn;

    location ^~ /.well-known/acme-challenge/ {
      root /var/www/certbot;
    }

    location / {
      return 301 https://$server_name$request_uri;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name cloud.ssemarket.cn;

    ssl_certificate     /etc/letsencrypt/live/ssemarket.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ssemarket.cn/privkey.pem;

    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5:!RC4:!DHE;
    ssl_prefer_server_ciphers on;

    client_max_body_size 50m;

    location / {
      proxy_pass http://host.docker.internal:24000;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
      proxy_buffering off;
    }
  }
